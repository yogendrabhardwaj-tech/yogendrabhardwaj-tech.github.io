---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import TracePanel from '../components/TracePanel.astro';
import { site, metrics, platforms, pillars, principles, research, about } from '../data/profile';
import { getWork } from '../lib/content';
import '../styles/home.css';

const work = (await getWork()).slice(0, 3);
const pub = research.publications[0];

const why = [
  { icon: 'shield', title: principles[0].title, text: principles[0].body },
  { icon: 'gauge', title: principles[1].title, text: principles[1].body },
  { icon: 'log', title: principles[2].title, text: principles[2].body },
  { icon: 'user', title: principles[3].title, text: principles[3].body },
  { icon: 'db', title: 'Data foundations first', text: 'Fifteen years of pipelines and platforms before GenAI — so the retrieval layer is solid, not an afterthought.' },
  { icon: 'link', title: 'Bridge to executives', text: 'Primary technical contact for client executives and Microsoft product engineering — architecture that leadership can follow.' },
];

const steps = [
  { n: 1, title: 'Discover & assess', text: 'Map the use case, data, risks and the regulatory controls that apply — GxP, HIPAA, 21 CFR Part 11, PCI.', tag: 'workshops' },
  { n: 2, title: 'Architect with guardrails', text: 'Design agents, retrieval and tools with RBAC, PII masking, approval gates and audit logging built in.', tag: 'architecture' },
  { n: 3, title: 'Deliver & evaluate', text: 'Ship behind an eval gate — golden sets, groundedness checks and human review before every release.', tag: 'release gate' },
];

const icons: Record<string, string> = {
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  gauge: '<path d="M4 15a8 8 0 1116 0"/><path d="M12 15l4-5"/>',
  log: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>',
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  link: '<path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/>',
};
---

<Base bleed>
  <div class="home">
    <!-- ── Hero with vertical bars ────────────────────────── -->
    <section class="hero">
      <div class="bars" aria-hidden="true">
        {Array.from({ length: 9 }, (_, i) => <span class="glint" style={`--x:${8 + i * 10.5}%;--d:${(i * 1.7) % 6}s;--w:${i % 3 === 0 ? 3 : 2}`}></span>)}
      </div>
      <div class="container hero-inner">
        <a class="hero-avatar" href="#about" aria-label={`About ${site.shortName}`}>
          <span class="ring"><img src="/headshot.jpg" alt={`Portrait of ${site.name}`} width="128" height="128" /><span class="online" aria-hidden="true"></span></span>
          <span class="tag-card">
            <strong>Hi, I’m Yogendra</strong>
            <span class="mono">Wilmington, DE · open to talk</span>
          </span>
        </a>
        <a class="announce" href={pub.url} target="_blank" rel="noopener">
          <span class="announce-tag">New</span>
          <span class="long">Published 2026 — securing MCP-mediated RAG pipelines against injection</span><span class="short">Published 2026: securing MCP-RAG pipelines</span>
          <span aria-hidden="true">→</span>
        </a>

        <h1 class="hero-title">Agentic AI that passes the audit.</h1>
        <p class="hero-sub">
          I architect AI agents and assistants for regulated life-sciences and financial-services enterprises —{' '}<a href="#build"><u>grounded</u></a>,{' '}<a href="#build"><u>governed</u></a>, and{' '}<a href="#build"><u>audited</u></a>{' '}from day one.
        </p>

        <div class="hero-cta">
          <a class="pill pill-solid lg" href="#work">View selected work</a>
          <a class="pill pill-outline lg" href="/research/profile/">Speaker profile</a>
        </div>

        <div class="status mono">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="muted-2">now</span>
          Agentic AI Technical Architect · Microsoft Discovery Studio · Accenture
        </div>

        <ul class="stat-chips" aria-label="Highlights">
          <li><strong>18 yrs</strong> enterprise delivery</li>
          <li><strong>4×</strong> Azure certified</li>
          <li><strong>200+</strong> users on grounded RAG</li>
        </ul>
      </div>
    </section>

    <!-- ── Platform marquee ───────────────────────────────── -->
    <section class="marquee" aria-label="Platforms I build on">
      <div class="track">
        {[0, 1].map((k) => (
          <ul aria-hidden={k === 1 ? 'true' : undefined}>
            {platforms.map((p) => <li>{p}</li>)}
          </ul>
        ))}
      </div>
    </section>

    <!-- ── Tabs ───────────────────────────────────────────── -->
    <section class="sec" id="build">
      <div class="container">
        <h2 class="sec-title center">What I build</h2>
        <p class="sec-sub center">Three layers of AI that hold up in production — and in front of an auditor.</p>

        <div class="u-tabs" role="tablist" aria-label="Capabilities" data-utabs>
          {pillars.map((p, i) => (
            <button role="tab" type="button" id={`ut-${p.id}`} aria-controls={`up-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.label}</button>
          ))}
        </div>

        {pillars.map((p, i) => (
          <div class="u-panel" role="tabpanel" id={`up-${p.id}`} aria-labelledby={`ut-${p.id}`} hidden={i !== 0}>
            <div class="u-copy">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
              <div class="u-links">
                <a href={p.caseStudy} class="tiny-pill">Case study →</a>
                <a href="#contact" class="tiny-link">Discuss a project →</a>
              </div>
            </div>
            <div class="u-visual">
              {i === 0 ? (
                <TracePanel />
              ) : (
                <div class="code-win">
                  <div class="code-bar"><i></i><i></i><i></i><span class="mono">{p.lang} · illustrative</span></div>
                  <Code code={p.code} lang={p.lang as any} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Proof band ─────────────────────────────────────── -->
    <section class="sec proof">
      <div class="container">
        <h2 class="sec-title center">Proven in regulated delivery</h2>
        <p class="sec-sub center">Eighteen years at Accenture — from .NET and data platforms to multi-agent systems.</p>
        <div class="proof-grid">
          {metrics.map((m) => (
            <div class="proof-item">
              <span class="proof-v">{m.value}<small>{m.unit}</small></span>
              <span class="proof-l">{m.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Why ────────────────────────────────────────────── -->
    <section class="sec">
      <div class="container">
        <h2 class="sec-title center">Why teams bring me in</h2>
        <p class="sec-sub center">Governance is a design input, not a review step.</p>
        <div class="why-grid">
          {why.map((w, i) => (
            <article class="why" style={`--hue:${i}`}>
              <span class="why-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[w.icon]} />
              </span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Work ───────────────────────────────────────────── -->
    <section class="sec" id="work">
      <div class="container">
        <h2 class="sec-title center">Selected work</h2>
        <p class="sec-sub center">Client names withheld. Architectures described generically.</p>
        <div class="work-grid">
          {work.map((w) => (
            <a class="work" href={`/work/${w.id}/`}>
              <span class="work-sector mono">{w.data.sector}</span>
              <h3>{w.data.title}</h3>
              <p>{w.data.summary}</p>
              <div class="work-metrics">
                {w.data.metrics.slice(0, 2).map((m) => <span><strong>{m.value}</strong> {m.label}</span>)}
              </div>
              <span class="work-go">Read case study →</span>
            </a>
          ))}
        </div>
        <p class="center more"><a class="tiny-link" href="/work/">All case studies →</a></p>
      </div>
    </section>

    <!-- ── Steps ──────────────────────────────────────────── -->
    <section class="sec">
      <div class="container">
        <h2 class="sec-title center">How an engagement runs</h2>
        <p class="sec-sub center">Three steps, with governance designed in from the first workshop.</p>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="step">
              <span class="step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="step-tag mono">{s.tag}</span>
              {i < steps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Research ───────────────────────────────────────── -->
    <section class="sec research">
      <div class="container r-grid">
        <div class="r-copy">
          <span class="eyebrow">Research &amp; impact</span>
          <h2 class="sec-title">Practitioner research, and giving it back.</h2>
          <p class="sec-sub">Published work on securing AI systems, a book on AI in progress, paper reviewing, and volunteer teaching for college students.</p>
          <div class="hero-cta left">
            <a class="pill pill-solid" href="/research/">Research &amp; impact</a>
            <a class="pill pill-outline" href="/research/profile/">Speaker profile</a>
          </div>
        </div>
        <a class="paper" href={pub.url} target="_blank" rel="noopener">
          <span class="paper-top mono">{pub.type} · {pub.year}</span>
          <h3>{pub.title}</h3>
          <p>{pub.authors.join(', ')}</p>
          <div class="paper-tags">{pub.tags.map((t) => <span>{t}</span>)}</div>
        </a>
      </div>
    </section>

    <!-- ── About strip ────────────────────────────────────── -->
    <section class="sec about-strip" id="about">
      <div class="container about-inner">
        <img src="/headshot.jpg" alt={`Portrait of ${site.name}`} width="132" height="132" />
        <div>
          <p class="about-quote">“{about.bio[0]}”</p>
          <p class="about-by mono">{site.name} · {site.role}</p>
        </div>
      </div>
    </section>

    <!-- ── Contact with bars ──────────────────────────────── -->
    <section class="cta" id="contact">
      <div class="container cta-inner">
        <h2 class="cta-title">Building agents for a regulated business?</h2>
        <p class="hero-sub">Architecture, delivery, speaking invitations, program committees or advisory roles — let’s talk.</p>
        <div class="hero-cta">
          <a class="pill pill-solid lg" href={`mailto:${site.email}`}>Email me</a>
          <a class="pill pill-outline lg" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="container foot-inner">
        <span>© 2026 {site.name}</span>
        <span class="muted-2">Views are my own. Client names withheld.</span>
      </div>
    </footer>
  </div>
</Base>

<script>
// Underline tabs.
document.querySelectorAll<HTMLElement>('[data-utabs]').forEach((list) => {
  const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const select = (t: HTMLButtonElement) =>
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const p = document.getElementById(x.getAttribute('aria-controls')!);
      if (p) p.hidden = !on;
    });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      n.focus();
      select(n);
    });
  });
});</script>

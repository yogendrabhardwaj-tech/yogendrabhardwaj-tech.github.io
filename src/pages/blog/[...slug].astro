---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { categories } from '../../data/blog';
import { getPosts, formatDate, readTime, tagSlug } from '../../lib/content';
import { site } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1], posts },
  }));
}

const { entry, newer, older, posts } = Astro.props;
const d = entry.data;
const cat = categories[d.category];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const mins = readTime(entry.body);
const related = posts.filter((p) => p.id !== entry.id && p.data.category === d.category).slice(0, 2);
const url = new URL(`/blog/${entry.id}/`, site.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: url,
  articleSection: cat.label,
  keywords: d.tags.join(', '),
};
---

<Base title={d.title} description={d.description} type="article" published={d.date} jsonLd={ld}>
  <article class="container narrow post">
    <a href="/blog/" class="back mono">← All posts</a>
    <header class="head">
      <div class="meta mono">
        <a class="cat" href={`/blog/category/${d.category}/`}>{cat.label}</a>
        <span aria-hidden="true">·</span>
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{mins} min read</span>
        {d.updated && <span>(updated {formatDate(d.updated)})</span>}
        {d.draft && <span class="placeholder-badge">Draft — not published</span>}
      </div>
      <h1 class="display title">{d.title}</h1>
      <p class="lede">{d.description}</p>
      {d.tags.length > 0 && <div class="tags">{d.tags.map((t) => <a class="tag" href={`/blog/tag/${tagSlug(t)}/`}>#{t}</a>)}</div>}
    </header>

    {d.cover && (
      <figure class="cover">
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 760, 1200]} sizes="(min-width: 800px) 760px, 100vw" loading="eager" />
      </figure>
    )}

    {toc.length >= 3 && (
      <nav class="toc" aria-label="On this page">
        <span class="mono">On this page</span>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose"><Content /></div>

    <footer class="foot">
      <p>Written by <strong>{site.name}</strong>, {site.role}. Views are my own.</p>
      <a class="link-arrow" href={site.linkedin} target="_blank" rel="noopener">Discuss on LinkedIn <span>↗</span></a>
    </footer>

    {(newer || older) && (
      <nav class="pager" aria-label="More posts">
        {older ? <a class="card" href={`/blog/${older.id}/`}><span class="mono">← Previous</span><strong>{older.data.title}</strong></a> : <span />}
        {newer && <a class="card next" href={`/blog/${newer.id}/`}><span class="mono">Next →</span><strong>{newer.data.title}</strong></a>}
      </nav>
    )}
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="container narrow">
        <h2 class="eyebrow">More in {cat.label}</h2>
        <div class="rl">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .post { padding-block: clamp(40px, 6vw, 72px) clamp(48px, 7vw, 80px); }
  .back { font-size: 0.8rem; color: var(--muted); }
  .back:hover { color: var(--accent); }
  .head { display: grid; gap: 18px; margin: 28px 0 40px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 0.78rem; color: var(--muted); }
  .cat { color: var(--label); text-transform: uppercase; letter-spacing: 0.1em; }
  .cat:hover { color: var(--accent); }
  .title { font-size: clamp(2.1rem, 4.6vw, 3.2rem); }
  .tags .tag:hover { color: var(--text); border-color: var(--accent); }
  .cover { margin: 0 0 40px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); }
  .cover :global(img) { width: 100%; height: auto; }
  .toc { margin-bottom: 40px; padding: 18px 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); display: grid; gap: 10px; }
  .toc span { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .toc ol { padding-left: 1.2em; display: grid; gap: 4px; color: var(--text-2); font-size: 0.95rem; }
  .toc a:hover { color: var(--accent); }
  .foot { margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 0.92rem; }
  .foot strong { color: var(--text); }
  .pager { margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pager .card { padding: 18px 20px; display: grid; gap: 6px; }
  .pager .card:hover { border-color: var(--border-strong); }
  .pager span { font-size: 0.75rem; color: var(--muted); }
  .pager strong { font-weight: 600; line-height: 1.35; }
  .next { text-align: right; }
  .related { border-top: 1px solid var(--border); padding-block: clamp(48px, 7vw, 80px); }
  .related .container { display: grid; gap: 20px; }
  .rl { display: grid; gap: 16px; }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .next { text-align: left; } }
</style>

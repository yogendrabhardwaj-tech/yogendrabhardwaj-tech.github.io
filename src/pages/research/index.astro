---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SessionCard from '../../components/SessionCard.astro';
import { getSessions } from '../../lib/content';
import { site, speakingTopics, research } from '../../data/profile';

const sessions = await getSessions();
const rendered = await Promise.all(sessions.map(async (s) => ({ entry: s, Content: (await render(s)).Content })));
const realSessions = sessions.filter((s) => !s.data.placeholder);
const institutions = new Set(realSessions.map((s) => s.data.institution)).size;
const { publications, book, reviewing } = research;
const venueCount = new Set(reviewing.records.map((r) => r.venue)).size;
const certs = reviewing.records.filter((r) => r.certificate);

const stats = [
  { value: String(publications.length), label: publications.length === 1 ? 'Published paper' : 'Published papers' },
  { value: '1', label: 'Book in progress' },
  { value: String(reviewing.records.length), label: `Peer reviews · ${venueCount} venues` },
  realSessions.length > 0
    ? { value: String(institutions), label: institutions === 1 ? 'Institution taught at' : 'Institutions taught at' }
    : { value: '✓', label: 'Guest lecturer' },
];

const ld = [
  ...publications.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: p.title,
    author: p.authors.map((name) => ({ '@type': 'Person', name })),
    datePublished: String(p.year),
    isPartOf: p.venue.replace(' …', ''),
    url: p.url,
  })),
  ...realSessions
    .filter((s) => s.data.date)
    .map((s) => ({
      '@context': 'https://schema.org',
      '@type': 'EducationEvent',
      name: s.data.topic,
      startDate: s.data.date!.toISOString().slice(0, 10),
      location: { '@type': 'Place', name: s.data.institution, address: s.data.location ?? s.data.institution },
      performer: { '@type': 'Person', name: site.name, url: site.url },
    })),
];

const inviteHref = `mailto:${site.email}?subject=${encodeURIComponent('Research / speaking collaboration')}`;
---

<Base
  title="Research & impact"
  description="Published research on securing MCP-mediated RAG pipelines, peer review for ICDSCNC 2026 and IGI Global, a forthcoming book on AI, and guest lectures for college students."
  jsonLd={ld}
>
  <!-- ── Header ───────────────────────────────────────────── -->
  <header class="r-hero bars-band">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow">Research &amp; impact</span>
      <h1 class="display title">Practitioner research, and giving it back.</h1>
      <p class="lede">
        I publish on securing AI systems, review research papers, am writing a book on AI — and volunteer in college
        classrooms so the next generation learns how AI is really built, governed and shipped.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/research/profile/">Speaker &amp; reviewer profile <span class="arrow">→</span></a>
        <a class="btn" href={research.scholar} target="_blank" rel="me noopener">Google Scholar ↗</a>
        <a class="btn" href={research.orcid} target="_blank" rel="me noopener">ORCID ↗</a>
        <a class="btn" href={inviteHref}>Collaborate</a>
      </div>
      <ul class="interests" aria-label="Research interests">
        {research.interests.map((i) => <li class="tag">{i}</li>)}
      </ul>
      <dl class="stats">
        {stats.map((s) => (<div><dt>{s.label}</dt><dd>{s.value}</dd></div>))}
      </dl>
    </div>
  </header>

  <!-- ── Publications ─────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="num">01</span> / Publications</span>
        <h2 class="h2">Published research.</h2>
      </div>
      <ol class="pubs">
        {publications.map((p) => (
          <li class="card pub">
            <div class="pub-meta">
              <span class="pub-year">{p.year}</span>
              <span class="tag">{p.type}</span>
            </div>
            <div class="pub-body">
              <h3 class="pub-title"><a href={p.url} target="_blank" rel="noopener">{p.title}</a></h3>
              <p class="pub-authors">
                {p.authors.map((a, i) => (
                  <>
                    {a.includes('Bhardwaj') ? <strong>{a}</strong> : a}{i < p.authors.length - 1 ? ', ' : ''}
                  </>
                ))}
              </p>
              <p class="pub-venue">{p.venue}</p>
              <div class="pub-foot">
                <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
                <a class="link-arrow" href={p.url} target="_blank" rel="noopener">View on Scholar <span>↗</span></a>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Peer review ──────────────────────────────────────── -->
  <section class="section alt" id="peer-review">
    <div class="container rv-grid">
      <div class="rv-intro">
        <div class="section-head">
          <span class="eyebrow"><span class="num">02</span> / Peer review</span>
          <h2 class="h2">Reviewing the research.</h2>
        </div>
        <p class="review-copy">{reviewing.summary}</p>
        <dl class="rv-stats">
          <div><dt>Reviews completed</dt><dd>{reviewing.records.length}</dd></div>
          <div><dt>Venues</dt><dd>{venueCount}</dd></div>
        </dl>
        <ul class="review-focus">
          <li><span class="mono num">01</span>Grounding, evaluation and hallucination control</li>
          <li><span class="mono num">02</span>AI, agent and network security</li>
          <li><span class="mono num">03</span>Production readiness of research ideas</li>
        </ul>
        <p class="rv-note mono">Manuscript titles are kept confidential, as peer review requires.</p>
      </div>

      <ol class="rv-list">
        {reviewing.records.map((r, i) => (
          <li class="card rv">
            <div class="rv-body">
              <div class="rv-meta">
                <span class="rv-kind mono">{r.kind}</span>
                <span class="mono muted">{r.date}</span>
                {r.reviewType && <span class="tag">{r.reviewType}</span>}
              </div>
              <h3 class="rv-venue">{r.venue}</h3>
              <p class="rv-full">{r.venueFull}</p>
              <p class="rv-org muted">{r.organizer}</p>
              <p class="rv-proof"><span class="ok">✓</span>{r.proof}</p>
            </div>
            {r.certificate && (
              <button type="button" class="rv-thumb" data-cert={r.certificate} data-cert-title={`${r.venue} — ${r.proof}`} aria-label={`View certificate: ${r.venue}`}>
                <img src={r.certificate} alt="" width="180" height="128" loading="lazy" />
                <span class="mono">View certificate ↗</span>
              </button>
            )}
          </li>
        ))}
      </ol>
    </div>

    <dialog class="cert-dialog" aria-label="Certificate">
      <form method="dialog"><button class="cert-close" aria-label="Close">✕</button></form>
      <img alt="" />
      <p class="mono cert-caption"></p>
    </dialog>
  </section>

  <!-- ── Writing ──────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <article class="book-wrap">
        <div class="section-head">
          <span class="eyebrow"><span class="num">03</span> / Writing</span>
          <h2 class="h2">A book on AI, in progress.</h2>
        </div>
        <div class="book">
          <div class="cover" aria-hidden="true">
            <span class="cover-top mono">YKB · {book.status}</span>
            <span class="cover-title">{book.title || 'Working title — to be announced'}</span>
            <span class="cover-rule"></span>
            <span class="cover-author">Yogendra K. Bhardwaj</span>
          </div>
          <div class="book-copy">
            <span class="status"><span class="pulse" aria-hidden="true"></span>{book.status}</span>
            {book.title && <h3 class="h3">{book.title}{book.subtitle && <span class="muted">: {book.subtitle}</span>}</h3>}
            <p>{book.blurb}</p>
            <a class="link-arrow" href={`mailto:${site.email}?subject=${encodeURIComponent('Book updates')}`}>Get notified at launch <span>→</span></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ── Giving back ──────────────────────────────────────── -->
  <section class="section alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><span class="num">04</span> / Giving back to education</span>
        <h2 class="h2">Volunteering in the classroom.</h2>
        <p class="muted">
          I volunteer my time with colleges and universities — guest lectures, workshops and hands-on labs that bring
          real-world AI and data engineering to students, and help them find a path into the industry.
        </p>
      </div>

      {rendered.length > 0 && (
        <div class="grid">
          {rendered.map(({ entry, Content }) => (
            <SessionCard entry={entry} showBody><Content /></SessionCard>
          ))}
        </div>
      )}

      <div class="invite card">
        <div class="stack">
          <span class="eyebrow">Invite me</span>
          <h3 class="invite-title">Topics I bring to students.</h3>
          <p class="muted">Lectures run 45–90 minutes; hands-on labs run half a day. Every session is grounded in real enterprise delivery.</p>
          <a class="btn btn-primary" href={inviteHref}>Send an invitation <span class="arrow">→</span></a>
        </div>
        <ol class="topics">
          {speakingTopics.map((t, i) => (
            <li><span class="mono num">{String(i + 1).padStart(2, '0')}</span>{t}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.cert-dialog');
  const img = dlg?.querySelector('img');
  const cap = dlg?.querySelector('.cert-caption');
  document.querySelectorAll<HTMLButtonElement>('[data-cert]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!dlg || !img || !cap) return;
      img.src = b.dataset.cert!;
      img.alt = b.dataset.certTitle!;
      cap.textContent = b.dataset.certTitle!;
      dlg.showModal();
    }),
  );
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .r-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--border); padding-block: clamp(56px, 8vw, 104px) clamp(44px, 6vw, 72px); }
  .glow {
    position: absolute; width: 900px; height: 600px; right: -200px; top: -300px;
    background: radial-gradient(closest-side, var(--glow), transparent); pointer-events: none;
  }
  .hero-inner { position: relative; display: grid; gap: 22px; }
  .title { font-size: clamp(2.4rem, 5.4vw, 4.2rem); max-width: 18ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .interests { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 20px; padding-top: 28px; border-top: 1px solid var(--border); }
  .stats div { display: flex; flex-direction: column-reverse; gap: 6px; border-left: 1px solid var(--border); padding-left: 16px; }
  .stats dt { font-size: 0.82rem; color: var(--muted); }
  .stats dd { font-family: var(--font-body); font-weight: 700; font-size: clamp(1.8rem, 3vw, 2.4rem); line-height: 1; }
  @media (max-width: 760px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Publications */
  .pubs { list-style: none; padding: 0; display: grid; gap: 16px; }
  .pub { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 28px; padding: 32px; }
  .pub-meta { display: grid; gap: 12px; align-content: start; justify-items: start; }
  .pub-year { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; color: var(--accent); }
  .pub-body { display: grid; gap: 10px; }
  .pub-title { font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 1.7rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.012em; }
  .pub-title a:hover { color: var(--accent); }
  .pub-authors { color: var(--text-2); font-size: 0.95rem; }
  .pub-authors strong { color: var(--text); font-weight: 600; }
  .pub-venue { color: var(--muted); font-style: italic; font-size: 0.92rem; }
  .pub-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border); }
  @media (max-width: 640px) { .pub { grid-template-columns: minmax(0, 1fr); gap: 14px; padding: 24px; } .pub-meta { display: flex; align-items: center; } }

  /* Book + review */
  .alt { background: var(--bg-elev); }
  .two { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(36px, 6vw, 80px); }
  @media (max-width: 900px) { .two { grid-template-columns: minmax(0, 1fr); } }
  .book { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 28px; align-items: center; max-width: 820px; }
  .cover {
    aspect-ratio: 2 / 3; border-radius: 4px 10px 10px 4px; padding: 20px 18px;
    display: flex; flex-direction: column; gap: 14px;
    background: linear-gradient(160deg, rgb(var(--c2-rgb) / 0.55) 0%, #14110f 55%, #0b0d12 100%);
    border: 1px solid rgb(var(--c3-rgb) / 0.45); color: #eef0f5;
    box-shadow: -6px 0 0 -2px rgb(0 0 0 / 0.35) inset, 0 30px 50px -20px rgb(0 0 0 / 0.55);
    transform: perspective(900px) rotateY(-8deg);
  }
  .cover-top { font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--label); }
  .cover-title { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.2; margin-top: auto; }
  .cover-rule { width: 36px; height: 2px; background: var(--c4); }
  .cover-author { font-size: 0.7rem; letter-spacing: 0.06em; color: #b8bfcc; }
  .book-copy { display: grid; gap: 14px; color: var(--text-2); }
  .status {
    justify-self: start; display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--verified); background: var(--verified-soft); padding: 4px 10px; border-radius: 999px;
  }
  .pulse { width: 6px; height: 6px; border-radius: 50%; background: var(--verified); }
  @media (prefers-reduced-motion: no-preference) { .pulse { animation: pulse 2s ease-in-out infinite; } }
  @keyframes pulse { 50% { opacity: 0.3; } }
  @media (max-width: 520px) { .book { grid-template-columns: 130px minmax(0, 1fr); gap: 18px; } }

  .review-copy { color: var(--text-2); }
  .venues { list-style: none; padding: 0; margin-top: 20px; display: grid; gap: 8px; }
  .ok { color: var(--verified); margin-right: 10px; }
  .review-focus { list-style: none; padding: 0; margin-top: 24px; border-top: 1px solid var(--border); }
  .review-focus li { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--border); }

  /* Peer review */
  .rv-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .rv-intro { position: sticky; top: calc(var(--nav-h) + 24px); }
  .rv-stats { display: flex; gap: 32px; margin-top: 24px; }
  .rv-stats div { display: flex; flex-direction: column-reverse; gap: 4px; }
  .rv-stats dt { font-size: 0.82rem; color: var(--muted); }
  .rv-stats dd { font-size: 2.4rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--accent); }
  .rv-note { margin-top: 18px; font-size: 0.72rem; color: var(--muted); }
  .rv-list { list-style: none; padding: 0; display: grid; gap: 16px; }
  .rv { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; padding: 26px; align-items: center; }
  .rv-body { display: grid; gap: 6px; }
  .rv-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 0.75rem; }
  .rv-kind { color: var(--label); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.7rem; }
  .rv-venue { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.025em; margin-top: 4px; }
  .rv-full { color: var(--text); font-size: 0.97rem; }
  .rv-org { font-size: 0.88rem; }
  .rv-proof { margin-top: 6px; font-size: 0.88rem; color: var(--text-2); }
  .rv-thumb {
    display: grid; gap: 8px; justify-items: center; padding: 8px; border-radius: 12px;
    border: 1px solid var(--border-strong); background: var(--bg-elev); transition: border-color 0.2s, transform 0.2s;
  }
  .rv-thumb:hover { border-color: var(--accent); transform: translateY(-2px); }
  .rv-thumb img { width: 180px; height: auto; border-radius: 6px; }
  .rv-thumb span { font-size: 0.7rem; color: var(--text-2); }
  .cert-dialog {
    max-width: min(940px, 94vw); padding: 16px; border-radius: 14px; border: 1px solid var(--border-strong);
    background: var(--surface); color: var(--text);
  }
  .cert-dialog::backdrop { background: rgb(0 0 0 / 0.72); backdrop-filter: blur(4px); }
  .cert-dialog img { width: 100%; height: auto; border-radius: 8px; }
  .cert-dialog form { display: flex; justify-content: flex-end; margin-bottom: 8px; }
  .cert-close { width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border-strong); }
  .cert-close:hover { border-color: var(--accent); color: var(--accent); }
  .cert-caption { margin-top: 10px; font-size: 0.75rem; color: var(--muted); text-align: center; }
  @media (max-width: 900px) {
    .rv-grid { grid-template-columns: minmax(0, 1fr); }
    .rv-intro { position: static; }
  }
  @media (max-width: 560px) {
    .rv { grid-template-columns: minmax(0, 1fr); }
    .rv-thumb { justify-self: start; }
  }

  /* Giving back */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px; }
  .invite { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); padding: clamp(24px, 4vw, 40px); align-items: start; }
  .invite .btn { justify-self: start; margin-top: 6px; }
  .invite-title { font-family: var(--font-body); font-size: 1.7rem; font-weight: 700; }
  .stack { display: grid; gap: 14px; }
  .topics { list-style: none; padding: 0; border-top: 1px solid var(--border); }
  .topics li { display: flex; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--border); }
  .num { color: var(--accent); font-size: 0.75rem; padding-top: 4px; }
  @media (max-width: 860px) { .invite { grid-template-columns: minmax(0, 1fr); } }
</style>

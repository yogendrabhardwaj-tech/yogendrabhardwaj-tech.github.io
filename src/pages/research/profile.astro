---
import Base from '../../layouts/Base.astro';
import { site, research, academicProfile as ap, metrics } from '../../data/profile';

const pub = research.publications[0];
const impact = metrics.filter((m) => ['18', '200+', '15→5', '4×'].includes(m.value));
---

<Base
  title="Speaker, reviewer & advisor profile"
  description={`One-page profile of ${site.name} for conference organizers — bio, speaking topics, reviewing areas and advisory roles.`}
  type="profile"
>
  <div class="page">
    <div class="container toolbar no-print">
      <div class="crumbs">
        <a href="/research/" class="mono back">← Research &amp; impact</a>
        <h1 class="page-title">Speaker, reviewer &amp; advisor profile</h1>
        <p class="muted">A one-page profile for conference committees. Save it as a PDF or copy a bio below.</p>
      </div>
      <div class="actions">
        <button type="button" class="btn btn-primary" data-print>Save as PDF ↓</button>
        <a class="btn" href="/headshot.jpg" download="Yogendra-Bhardwaj-headshot.jpg">Headshot ↓</a>
      </div>
    </div>

    <!-- ── The one-pager ───────────────────────────────────── -->
    <article class="sheet" aria-label="One-page profile">
      <header class="s-head">
        <img src="/headshot.jpg" alt={`Portrait of ${site.name}`} width="120" height="120" class="s-photo" />
        <div class="s-id">
          <h2 class="s-name">{site.name}</h2>
          <p class="s-title">{ap.title}</p>
          <p class="s-contact">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <span>·</span><a href={site.linkedin}>linkedin.com/in/yogendrabhardwaj</a>
            <span>·</span><a href={site.url}>yogendrabhardwaj.runs-on.dev</a>
            <span>·</span><a href={research.scholar}>Google Scholar</a>
          </p>
        </div>
      </header>

      <div class="s-body">
        <div class="s-main">
          <section>
            <h3 class="s-h">Biography</h3>
            <p class="s-bio">{ap.bioLong}</p>
          </section>

          <section>
            <h3 class="s-h">How I can contribute</h3>
            <ol class="s-roles">
              {ap.roles.map((r) => (
                <li><strong>{r.role}</strong><span>{r.detail}</span></li>
              ))}
            </ol>
          </section>

          <section>
            <h3 class="s-h">Signature talks</h3>
            <ol class="s-talks">
              {ap.talks.map((t, i) => (
                <li>
                  <span class="s-num">{String(i + 1).padStart(2, '0')}</span>
                  <div><strong>{t.title}</strong><span>{t.abstract}</span></div>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <aside class="s-side">
          <section>
            <h3 class="s-h">Research interests</h3>
            <ul class="s-chips">{research.interests.map((i) => <li>{i}</li>)}</ul>
          </section>

          <section>
            <h3 class="s-h">Publication</h3>
            <p class="s-pub"><strong>{pub.title}</strong><br />{pub.authors.join(', ')}. <em>{pub.venue}</em>, {pub.year}.</p>
          </section>

          <section>
            <h3 class="s-h">Book</h3>
            <p class="s-small">{research.book.title || 'A book on AI'} — {research.book.status.toLowerCase()}.</p>
          </section>

          <section>
            <h3 class="s-h">Credentials</h3>
            <ul class="s-list">{ap.credentials.map((c) => <li>{c}</li>)}</ul>
          </section>

          <section>
            <h3 class="s-h">Industry impact</h3>
            <dl class="s-metrics">
              {impact.map((m) => (<div><dt>{m.label}</dt><dd>{m.value}{m.unit && <small> {m.unit}</small>}</dd></div>))}
            </dl>
          </section>
        </aside>
      </div>

      <footer class="s-foot">
        <span>Available for keynotes, technical program committees, paper review and industry advisory roles.</span>
        <span>{site.url.replace('https://', '')}/research/profile</span>
      </footer>
    </article>

    <!-- ── Copy-ready bios ─────────────────────────────────── -->
    <section class="container bios no-print">
      <h2 class="h2">Bios for programs &amp; websites</h2>
      <div class="bio-grid">
        {[
          { label: 'Short bio', words: ap.bioShort.split(/\s+/).length, text: ap.bioShort, id: 'bio-short' },
          { label: 'Full bio', words: ap.bioLong.split(/\s+/).length, text: ap.bioLong, id: 'bio-long' },
        ].map((b) => (
          <div class="card bio-card">
            <div class="bio-top">
              <span class="eyebrow">{b.label} · {b.words} words</span>
              <button type="button" class="copy" data-copy={b.id}>Copy</button>
            </div>
            <p id={b.id}>{b.text}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy!)?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = 'Select & copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1800);
    });
  });
</script>

<style>
  .page { padding-block: clamp(32px, 5vw, 56px) clamp(64px, 9vw, 112px); }
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; }
  .crumbs { display: grid; gap: 10px; }
  .back { font-size: 0.8rem; color: var(--muted); }
  .back:hover { color: var(--accent); }
  .page-title { font-family: var(--font-display); font-size: clamp(1.8rem, 3.4vw, 2.6rem); font-weight: 450; letter-spacing: -0.02em; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }

  /* The sheet: always paper-white so it reads like the PDF it becomes. */
  .sheet {
    --ink: #14161a; --ink-2: #3a3f4a; --ink-3: #6b7180; --rule: #e3e3dd; --accent-p: var(--c2);
    max-width: 920px; margin-inline: auto;
    background: #fff; color: var(--ink);
    border-radius: 6px; padding: 44px 48px 30px;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.55), 0 0 0 1px var(--border);
    font-size: 13px; line-height: 1.5;
  }
  .sheet a { color: inherit; }
  .s-head { display: grid; grid-template-columns: 104px 1fr; gap: 24px; align-items: center; padding-bottom: 20px; border-bottom: 2px solid var(--ink); }
  .s-photo { width: 104px; height: 104px; border-radius: 8px; object-fit: cover; }
  .s-name { font-family: var(--font-display); font-size: 32px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.05; }
  .s-title { margin-top: 6px; font-size: 14px; font-weight: 600; color: var(--accent-p); }
  .s-contact { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 8px; font-size: 11.5px; color: var(--ink-2); }
  .s-contact span { color: var(--ink-3); }

  .s-body { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 30px; padding-top: 20px; }
  .s-main, .s-side { display: grid; gap: 18px; align-content: start; }
  .s-side { padding-left: 26px; border-left: 1px solid var(--rule); }
  .s-h {
    font-family: var(--font-mono); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent-p); margin-bottom: 8px;
  }
  .s-bio { color: var(--ink-2); font-size: 12.5px; }

  .s-roles { list-style: none; padding: 0; display: grid; gap: 8px; }
  .s-roles li { display: grid; gap: 1px; padding-left: 12px; border-left: 2px solid var(--accent-p); }
  .s-roles strong { font-size: 13px; }
  .s-roles span { color: var(--ink-2); font-size: 12px; }

  .s-talks { list-style: none; padding: 0; display: grid; gap: 9px; }
  .s-talks li { display: grid; grid-template-columns: 22px 1fr; gap: 8px; }
  .s-num { font-family: var(--font-mono); font-size: 10.5px; color: var(--accent-p); padding-top: 2px; }
  .s-talks div { display: grid; gap: 1px; }
  .s-talks strong { font-size: 12.5px; }
  .s-talks span { color: var(--ink-2); font-size: 11.5px; }

  .s-chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 5px; }
  .s-chips li { font-size: 10.5px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--rule); background: #f6f6f2; }
  .s-pub, .s-small { font-size: 11.5px; color: var(--ink-2); }
  .s-pub strong { color: var(--ink); }
  .s-list { padding-left: 14px; display: grid; gap: 4px; font-size: 11.5px; color: var(--ink-2); }
  .s-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
  .s-metrics div { display: flex; flex-direction: column-reverse; }
  .s-metrics dd { font-family: var(--font-display); font-size: 20px; line-height: 1.1; }
  .s-metrics small { font-family: var(--font-mono); font-size: 10px; color: var(--ink-3); }
  .s-metrics dt { font-size: 10.5px; color: var(--ink-3); line-height: 1.35; }

  .s-foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px;
    margin-top: 22px; padding-top: 12px; border-top: 1px solid var(--rule);
    font-size: 10.5px; color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .sheet { padding: 26px 22px; }
    .s-head { grid-template-columns: 72px 1fr; gap: 16px; }
    .s-photo { width: 72px; height: 72px; }
    .s-name { font-size: 24px; }
    .s-body { grid-template-columns: minmax(0, 1fr); }
    .s-side { padding-left: 0; border-left: 0; border-top: 1px solid var(--rule); padding-top: 18px; }
  }

  /* Copy-ready bios */
  .bios { margin-top: clamp(56px, 8vw, 88px); display: grid; gap: 24px; }
  .bio-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 20px; align-items: start; }
  .bio-card { padding: 24px; display: grid; gap: 14px; color: var(--text-2); font-size: 0.95rem; }
  .bio-top { display: flex; justify-content: space-between; align-items: center; }
  .copy { font-family: var(--font-mono); font-size: 0.75rem; padding: 6px 12px; border: 1px solid var(--border-strong); border-radius: 999px; }
  .copy:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 860px) { .bio-grid { grid-template-columns: minmax(0, 1fr); } }

  @media print {
    :global(html), :global(body) { background: #fff !important; }
    .page { padding: 0; }
    .sheet { max-width: none; box-shadow: none; border-radius: 0; padding: 0; font-size: 11px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .s-head { padding-bottom: 14px; }
    .s-body { padding-top: 14px; gap: 24px; }
    .s-main, .s-side { gap: 13px; }
    .s-bio { font-size: 11.3px; line-height: 1.45; }
    .s-roles { gap: 6px; }
    .s-talks { gap: 6px; }
    .s-roles span, .s-talks span { font-size: 10.8px; }
    .s-foot { margin-top: 14px; padding-top: 8px; }
    .sheet { break-inside: avoid; }
    .s-body { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); }
    .s-side { padding-left: 22px; border-left: 1px solid var(--rule); border-top: 0; padding-top: 0; }
    @page { size: letter; margin: 11mm 12mm; }
  }
</style>

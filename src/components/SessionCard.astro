---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'sessions'>; showBody?: boolean }
const { entry, showBody = false } = Astro.props;
const d = entry.data;
const date = d.date?.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<article class:list={['card', 'session', { 'is-placeholder': d.placeholder }]}>
  <div class="row">
    <span class="tag">{d.format}</span>
    {d.placeholder ? <span class="placeholder-badge">Placeholder</span> : date && <span class="mono muted">{date}</span>}
  </div>
  <h3 class="topic">{d.topic}</h3>
  <p class="where">
    <strong>{d.institution}</strong>{d.department && <span> · {d.department}</span>}
    {d.location && <span> · {d.location}</span>}
  </p>
  {d.audience && <p class="aud mono">{d.audience}</p>}
  {showBody && <div class="body"><slot /></div>}
  {d.testimonial && (
    <blockquote class="quote">
      <p>“{d.testimonial.quote}”</p>
      <cite>— {d.testimonial.by}</cite>
    </blockquote>
  )}
  {d.slides && <a class="link-arrow" href={d.slides} target="_blank" rel="noopener">Slides <span>↗</span></a>}
</article>

<style>
  .session { display: flex; flex-direction: column; gap: 12px; padding: 24px; height: 100%; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .topic { font-size: 1.12rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
  .where { color: var(--text-2); font-size: 0.92rem; }
  .where strong { color: var(--text); font-weight: 600; }
  .aud { color: var(--muted); font-size: 0.78rem; margin-top: auto; }
  .body { color: var(--text-2); font-size: 0.93rem; }
  .quote { border-left: 2px solid var(--accent); padding-left: 14px; font-size: 0.93rem; color: var(--text-2); }
  .quote cite { display: block; margin-top: 6px; font-style: normal; font-size: 0.8rem; color: var(--muted); }
</style>

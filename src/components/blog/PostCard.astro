---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categories } from '../../data/blog';
import { formatDate, readTime } from '../../lib/content';

interface Props { post: CollectionEntry<'blog'>; featured?: boolean }
const { post, featured = false } = Astro.props;
const d = post.data;
const cat = categories[d.category];
---

<article class:list={['pc card', { featured }]}>
  <a href={`/blog/${post.id}/`} class="media" tabindex="-1" aria-hidden="true">
    {d.cover ? (
      <Image src={d.cover} alt="" widths={featured ? [480, 800, 1100] : [360, 560]} sizes={featured ? '(min-width: 900px) 800px, 100vw' : '(min-width: 700px) 300px, 100vw'} loading={featured ? 'eager' : 'lazy'} />
    ) : (
      <div class="ph bars-band"><svg viewBox="0 0 24 24" fill="currentColor"><path d={cat.icon} /></svg></div>
    )}
  </a>
  <div class="body">
    <div class="top">
      <a class="cat mono" href={`/blog/category/${d.category}/`}>{cat.label}</a>
      {d.draft && <span class="placeholder-badge">Draft</span>}
    </div>
    <h3 class="t"><a href={`/blog/${post.id}/`}>{d.title}</a></h3>
    <p class="ex">{d.description}</p>
    <p class="meta mono">
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readTime(post.body)} min read</span>
    </p>
  </div>
</article>

<style>
  .pc { display: grid; grid-template-columns: 3fr 4fr; gap: 22px; padding: 12px; position: relative; }
  .pc:hover { border-color: var(--border-strong); transform: translateY(-2px); }
  .media { display: block; border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 10; background: var(--surface-2); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .pc:hover .media :global(img) { transform: scale(1.03); }
  .ph { width: 100%; height: 100%; display: grid; place-items: center; color: rgb(255 255 255 / 0.9); }
  .ph svg { width: 22%; max-width: 64px; filter: drop-shadow(0 4px 14px rgb(0 0 0 / 0.4)); }
  .body { display: grid; align-content: center; gap: 10px; padding: 6px 8px 6px 0; }
  .top { display: flex; gap: 10px; align-items: center; }
  .cat { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--label); }
  .cat:hover { color: var(--accent); }
  .t { font-family: var(--font-body); font-size: 1.25rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .t a { transition: color 0.2s; }
  .t a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; } /* whole card clickable */
  .pc:hover .t a { color: var(--accent); }
  .cat { position: relative; z-index: 1; }
  .ex { color: var(--text-2); font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { display: flex; gap: 8px; font-size: 0.75rem; color: var(--muted); }

  .featured { grid-template-columns: 1fr; gap: 0; padding: 0; overflow: hidden; }
  .featured .media { border-radius: 0; aspect-ratio: 2 / 1; }
  .featured .body { padding: 24px 28px 28px; gap: 12px; }
  .featured .t { font-size: clamp(1.5rem, 3vw, 2rem); }

  @media (max-width: 640px) {
    .pc { grid-template-columns: 1fr; gap: 14px; }
    .body { padding: 0 6px 8px; }
    .featured .body { padding: 18px 18px 22px; }
  }
</style>

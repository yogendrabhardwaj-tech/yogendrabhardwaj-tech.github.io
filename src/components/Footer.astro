---
import { site } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container foot">
    <div class="left">
      <span class="mark" aria-hidden="true">YB</span>
      <p>© {year} {site.name}. Views are my own. Client names are withheld; architectures are described generically.</p>
    </div>
    <ul class="links">
      <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
      <li><a href={site.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href="#main">Back to top ↑</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding-block: 36px; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .left { display: flex; align-items: center; gap: 14px; max-width: 640px; }
  .left p { font-size: 0.85rem; color: var(--muted); }
  .mark {
    flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 7px;
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600;
    border: 1px solid var(--border-strong); color: var(--text-2);
  }
  .links { display: flex; flex-wrap: wrap; gap: 22px; list-style: none; padding: 0; font-size: 0.88rem; color: var(--text-2); }
  .links a:hover { color: var(--accent); }
</style>

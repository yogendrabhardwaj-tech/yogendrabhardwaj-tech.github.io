---
import { research } from '../data/profile';
import { getWork } from '../lib/content';

const work = await getWork();
const menus = [
  {
    label: 'Expertise',
    items: [
      { href: '/#industries', title: 'Industries', text: 'Banking, insurance, pharma, transit, manufacturing…' },
      { href: '/#build', title: 'Agentic AI', text: 'Multi-agent systems with humans in the loop' },
      { href: '/#build', title: 'Grounded RAG', text: 'Answers that cite their source — or decline' },
      { href: '/#build', title: 'Data & Modernization', text: 'Pipelines, platforms and legacy migration' },
      { href: '/lab/', title: 'Lab', text: 'Open-source tools and reference builds' },
    ],
  },
  {
    label: 'Work',
    items: [
      ...work.slice(0, 4).map((w) => ({ href: `/work/${w.id}/`, title: w.data.title, text: w.data.sector })),
      { href: '/work/', title: 'All case studies →', text: `${work.length} case studies across industries` },
    ],
  },
  {
    label: 'Research',
    items: [
      { href: '/research/', title: 'Research & impact', text: 'Publications, book, peer review, teaching' },
      { href: '/research/profile/', title: 'Speaker & reviewer profile', text: 'One-pager for conference committees' },
      { href: research.scholar, title: 'Google Scholar ↗', text: 'Publication record' },
    ],
  },
];
---

<header class="nav" data-nav>
<div class="container nav-bar">
  <a href="/" class="logo" aria-label="Yogendra Bhardwaj — Professional Snapshot, home">
    <span class="logo-mark" aria-hidden="true">YB</span>
    <span class="logo-text">
      <span class="logo-name">Yogendra Bhardwaj</span>
      <span class="logo-sub">Professional Snapshot</span>
    </span>
  </a>

  <nav aria-label="Primary" class="menu">
    <ul>
      {menus.map((m, i) => (
        <li class="has-dd">
          <button type="button" class="menu-btn" aria-expanded="false" aria-controls={`dd-${i}`}>
            {m.label}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="dd" id={`dd-${i}`}>
            {m.items.map((it) => (
              <a href={it.href} class="dd-item">
                <strong>{it.title}</strong>
                <span>{it.text}</span>
              </a>
            ))}
          </div>
        </li>
      ))}
      <li><a class="menu-link" href="/blog/">Blog</a></li>
      <li><a class="menu-link" href="/notes/">Notes</a></li>
    </ul>
  </nav>

  <div class="nav-cta">
    <a class="chip-btn" href={research.scholar} target="_blank" rel="noopener" aria-label="Google Scholar">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3L1 9l11 6 9-4.9V17h2V9L12 3zm-6 9.2v4L12 20l6-3.8v-4L12 16l-6-3.8z"/></svg>
      Scholar
    </a>
    <a class="pill pill-outline" href="/resume/">Résumé</a>
    <a class="pill pill-solid" href="/#contact"><span class="long">Get in touch</span><span class="short">Contact</span></a>
    <details class="burger">
      <summary aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav class="burger-panel" aria-label="Mobile">
        <div class="bp-group"><a href="/#contact" class="bp-contact">Get in touch →</a></div>
        {menus.map((m) => (
          <div class="bp-group">
            <span class="bp-label mono">{m.label}</span>
            {m.items.map((it) => <a href={it.href}>{it.title}</a>)}
          </div>
        ))}
        <div class="bp-group">
          <a href="/blog/">Blog</a>
          <a href="/notes/">Notes</a>
          <a href="/resume/">Résumé</a>
          <a href={research.scholar}>Google Scholar ↗</a>
        </div>
        <div class="bp-group bp-theme">
          <span class="bp-label mono">Theme</span>
          <div class="bp-swatches">
            <button type="button" data-set-palette="sunrise"><span class="sw sw-sunrise" aria-hidden="true"></span>Sunrise</button>
            <button type="button" data-set-palette="aurora"><span class="sw sw-aurora" aria-hidden="true"></span>Aurora</button>
          </div>
        </div>
      </nav>
    </details>
    <div class="palette">
      <button type="button" class="palette-btn" aria-label="Change color theme" aria-expanded="false" title="Color theme">
        <span class="swatch" aria-hidden="true"></span>
      </button>
      <div class="palette-pop" role="menu" aria-label="Color theme">
        <span class="pp-title mono">Theme</span>
        <button type="button" role="menuitemradio" data-set-palette="sunrise"><span class="sw sw-sunrise" aria-hidden="true"></span>Sunrise</button>
        <button type="button" role="menuitemradio" data-set-palette="aurora"><span class="sw sw-aurora" aria-hidden="true"></span>Aurora</button>
      </div>
    </div>
  </div>
</div>
</header>

<script>
  // Dropdown menus: hover on desktop (CSS), click/keyboard everywhere.
  const btns = document.querySelectorAll<HTMLButtonElement>('.menu-btn');
  const closeAll = (except?: HTMLButtonElement) =>
    btns.forEach((b) => b !== except && b.setAttribute('aria-expanded', 'false'));
  btns.forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = b.getAttribute('aria-expanded') === 'true';
      closeAll(b);
      b.setAttribute('aria-expanded', String(!open));
    }),
  );

  // Palette switcher — Sunrise is the default; Aurora is stored as an override.
  const pBtn = document.querySelector<HTMLButtonElement>('.palette-btn');
  const pWrap = document.querySelector<HTMLElement>('.palette');
  const closePalette = () => {
    pBtn?.setAttribute('aria-expanded', 'false');
    pWrap?.classList.remove('open');
  };
  const markPalette = () => {
    const cur = document.documentElement.dataset.palette || 'sunrise';
    document.querySelectorAll<HTMLButtonElement>('[data-set-palette]').forEach((b) =>
      b.setAttribute('aria-checked', String(b.dataset.setPalette === cur)),
    );
  };
  markPalette();
  pBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = pBtn.getAttribute('aria-expanded') === 'true';
    pBtn.setAttribute('aria-expanded', String(!open));
    pWrap?.classList.toggle('open', !open);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-set-palette]').forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const v = b.dataset.setPalette!;
      if (v === 'sunrise') delete document.documentElement.dataset.palette;
      else document.documentElement.dataset.palette = v;
      try { localStorage.setItem('palette', v); } catch {}
      markPalette();
      closePalette();
    }),
  );

  document.addEventListener('click', () => { closeAll(); closePalette(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeAll(); closePalette(); } });

  // Solid nav after scrolling.
  const nav = document.querySelector('[data-nav]');
  const onScroll = () => nav?.classList.toggle('solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
